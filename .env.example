# VPS par isko .env.local mein copy karke values badlo
NEXT_PUBLIC_SITE_URL=https://pulse.akclnt.com
# SQLite file ka rasta (folder khud ban jata hai)
DATABASE_PATH=./data/earthpulse.db
# Lamba random string: openssl rand -hex 16
IP_SALT=change-me
# /admin panel ka password (kam az kam 12 characters)
ADMIN_KEY=change-me-to-a-long-secret
